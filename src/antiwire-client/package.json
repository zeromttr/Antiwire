{
  "name": "antiwire-client",
  "productName": "Antiwire",
  "version": "0.1.0",
  "description": "Antiwire desktop client",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Antiwire",
  "license": "MIT",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#shared/*": "./shared/*"
  },
  "scripts": {
    "dev": "bun --bun electron-vite dev",
    "dev:web": "bun --bun vite --config vite.web.config.ts",
    "build": "bun --bun electron-vite build",
    "preview": "bun --bun electron-vite preview",
    "clean": "rm -rf node_modules out dist test-results playwright-report src/lib/paraglide",
    "check": "bun run typecheck && bun run lint",
    "typecheck": "bun run paraglide && bun check --no-script -p tsconfig.web.json && bun check --no-script -p tsconfig.node.json",
    "lint": "eslint . --max-warnings=0 --cache --cache-location node_modules/.cache/eslint/",
    "format": "bun fmt src electron shared",
    "test": "bun run paraglide && bun test",
    "test:watch": "bun test --watch",
    "test:visual": "playwright test",
    "audit": "bun audit",
    "paraglide": "bun scripts/paraglide.ts",
    "update:country-cidrs": "node scripts/update-country-cidrs.mjs",
    "package": "bun run build && electron-builder --config electron-builder.yml",
    "package:dir": "bun run build && electron-builder --config electron-builder.yml --dir"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@inlang/paraglide-js": "^3.2.1",
    "@inlang/plugin-m-function-matcher": "^2.4.3",
    "@inlang/plugin-message-format": "^4.6.0",
    "@internationalized/date": "^3.12.4",
    "@playwright/test": "^1.65.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/node": "26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@visx/curve": "^4.0.0",
    "@visx/gradient": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "bun-types": "1.4.4",
    "clsx": "^2.1.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.14.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "8.3",
    "zod": "^4.1.0"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ]
}
